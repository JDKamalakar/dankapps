[Desktop Entry]
Name=DUX Calculator
GenericName=Calculator
Comment=Calculator for DMS
Exec=sh -c "PATH=$HOME/.local/bin:$PATH exec dcalc \"$@\"" -- %u
Icon=com.danklinux.dankcalc
Terminal=false
Type=Application
Categories=Utility;Calculator;Qt;
Keywords=calculator;math;scientific;dank;
StartupNotify=true
StartupWMClass=com.danklinux.dankcalc
