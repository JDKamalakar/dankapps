[Desktop Entry]
Name=DUX Video Player
Comment=Video player for DMS
Exec=sh -c "PATH=$HOME/.local/bin:$PATH exec dplay \"$@\"" -- %F
Icon=com.danklinux.dankvideo
Terminal=false
Type=Application
Categories=AudioVideo;Video;Player;Qt;
MimeType=video/mp4;video/x-matroska;video/webm;video/quicktime;video/x-msvideo;video/x-flv;video/x-ms-wmv;video/ogg;
StartupNotify=true
