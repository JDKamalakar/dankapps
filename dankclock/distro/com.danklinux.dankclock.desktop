[Desktop Entry]
Name=DUX Clock
GenericName=Clock & Timer
Comment=Clock, Alarm, Timer & Stopwatch for DMS
Exec=sh -c "PATH=$HOME/.local/bin:$PATH exec dclock \"$@\"" -- %u
Icon=com.danklinux.dankclock
Terminal=false
Type=Application
Categories=Utility;Clock;Qt;
Keywords=clock;alarm;timer;stopwatch;world;dank;
StartupNotify=true
StartupWMClass=com.danklinux.dankclock
